APP_NAME=Backend API
ENVIRONMENT=development

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/payroll_db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Administrator

# Payslip email. EMAIL_BACKEND=file writes .eml files to EMAIL_OUTBOX_DIR instead of sending.
EMAIL_BACKEND=file
EMAIL_FROM=payroll@example.com
EMAIL_OUTBOX_DIR=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
